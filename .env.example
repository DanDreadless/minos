# Copy to .env (git-ignored) and fill in. Used by scripts/release.sh,
# which sources .env automatically; see docs/releasing.md.

# Gitea (source of truth): Settings → Applications → Generate token,
# "repository" write scope.
GITEA_TOKEN=

# GitHub mirror: personal access token with `repo` AND `workflow` scope
# — pushes touching .github/workflows/ are rejected without the latter.
# Only needed when the Gitea push mirror is not configured.
GITHUB_TOKEN=

# Optional overrides (defaults shown):
# GITEA_URL=http://vault-tec.local:3000
# GITEA_REPO=dreadless/minos
# GITHUB_REPO=DanDreadless/minos
